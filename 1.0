    <main>
      <section class="page-hero" aria-labelledby="factory-page-title">
        <p class="eyebrow">Factory</p>
        <h1 id="factory-page-title">A practical production flow for export fence orders.</h1>
        <p>
          HJ Fence supports fence buyers with product confirmation, metal fabrication, surface finishing coordination,
          packing, and container shipment preparation from Tianjin, China.
        </p>
      </section>

      <section class="section factory" aria-labelledby="factory-process-title">
        <div class="section-title-row">
          <div>
            <p class="eyebrow">Design. Manufacture. Support.</p>
            <h2 id="factory-process-title">Clear steps from inquiry to repeat orders.</h2>
          </div>
        </div>
        <div class="process-grid">
          <article>
            <span>01</span>
            <h3>Confirm Specifications</h3>
            <p>Share product size, mesh, tube thickness, coating, accessories, packing, destination, and target quantity.</p>
          </article>
          <article>
            <span>02</span>
            <h3>Fabricate & Finish</h3>
            <p>Production can include cutting, welding, drilling, bending, galvanizing coordination, and powder coating.</p>
          </article>
          <article>
            <span>03</span>
            <h3>Inspect & Pack</h3>
            <p>Panels and accessories are checked, bundled, protected, labeled, and prepared for container loading.</p>
          </article>
          <article>
            <span>04</span>
            <h3>Support Repeat Orders</h3>
            <p>Keep drawings, packing details, and previous order notes organized so repeat shipments are easier.</p>
          </article>
        </div>
      </section>

      <section class="section factory-gallery" aria-labelledby="factory-gallery-title">
        <div class="section-title-row">
          <div>
            <p class="eyebrow">Factory Tour</p>
            <h2 id="factory-gallery-title">Inside our production workshop.</h2>
          </div>
          <p>
            Real workshop views from HJ Fence, including metal processing, welding, mesh production, material handling,
            and order coordination areas.
          </p>
        </div>
        <div class="factory-photo-grid">
          <figure class="factory-photo-card featured">
            <img src="assets/factory/main-workshop.jpg" alt="HJ Fence main production workshop with crane and loading area" />
            <figcaption>
              <strong>Main Workshop</strong>
              <span>Large-scale production space for fence fabrication, packing, and material movement.</span>
            </figcaption>
          </figure>
          <figure class="factory-photo-card tall">
            <img src="assets/factory/mesh-production-line.jpg" alt="Welded mesh production line inside HJ Fence factory" loading="lazy" />
            <figcaption>
              <strong>Mesh Production Line</strong>
              <span>Equipment used for welded mesh and panel production.</span>
            </figcaption>
          </figure>
          <figure class="factory-photo-card">
            <img src="assets/factory/pipe-processing-line.jpg" alt="Pipe processing line for fence posts and frames" loading="lazy" />
            <figcaption>
              <strong>Pipe Processing Line</strong>
              <span>Tube cutting and shaping equipment for fence frames and posts.</span>
            </figcaption>
          </figure>
          <figure class="factory-photo-card">
            <img src="assets/factory/laser-cutting-machine.jpg" alt="Laser cutting machine for metal fence components" loading="lazy" />
            <figcaption>
              <strong>Laser Cutting Machine</strong>
              <span>Automated cutting equipment for accurate metal components.</span>
            </figcaption>
          </figure>
          <figure class="factory-photo-card">
            <img src="assets/factory/tube-forming-line.jpg" alt="Tube forming line for galvanized fence parts" loading="lazy" />
            <figcaption>
              <strong>Tube Forming Line</strong>
              <span>Forming line for galvanized tubes and fence components.</span>
            </figcaption>
          </figure>
          <figure class="factory-photo-card">
            <img src="assets/factory/production-line.jpg" alt="Fence production line with processing equipment" loading="lazy" />
            <figcaption>
              <strong>Production Line</strong>
              <span>Fabrication line for fence frames and tubular components.</span>
            </figcaption>
          </figure>
          <figure class="factory-photo-card">
            <img src="assets/factory/tube-cutting-line.jpg" alt="Automatic tube cutting equipment for repeat production" loading="lazy" />
            <figcaption>
              <strong>Tube Cutting Line</strong>
              <span>Automatic pipe cutting line for repeat production.</span>
            </figcaption>
          </figure>
          <figure class="factory-photo-card">
            <img src="assets/factory/welding-station.jpg" alt="Welding equipment and gas cylinders in the factory" loading="lazy" />
            <figcaption>
              <strong>Welding Station</strong>
              <span>Welding stations and gas equipment for frame fabrication.</span>
            </figcaption>
          </figure>
          <figure class="factory-photo-card">
            <img src="assets/factory/welding-fixture-table.jpg" alt="Welding fixture table for fence frame assembly" loading="lazy" />
            <figcaption>
              <strong>Welding Fixture Table</strong>
              <span>Fixture platform for welded mesh and frame assembly.</span>
            </figcaption>
          </figure>
          <figure class="factory-photo-card">
            <img src="assets/factory/inspection-platform.jpg" alt="Factory inspection platform and workshop setup area" loading="lazy" />
            <figcaption>
              <strong>Inspection Platform</strong>
              <span>Workshop platform used for setup and production checks.</span>
            </figcaption>
          </figure>
          <figure class="factory-photo-card">
            <img src="assets/factory/material-storage-area.jpg" alt="Factory material storage area with coils and packed materials" loading="lazy" />
            <figcaption>
              <strong>Material Storage Area</strong>
              <span>Workshop storage for coils, mesh, and packed materials.</span>
            </figcaption>
          </figure>
          <figure class="factory-photo-card">
            <img src="assets/factory/meeting-room.jpg" alt="Meeting room for project review and order coordination" loading="lazy" />
            <figcaption>
              <strong>Meeting Room</strong>
              <span>Meeting space for project review and order coordination.</span>
            </figcaption>
          </figure>
        </div>
      </section>

