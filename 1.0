:root {
  --orange: #f37016;
  --orange-dark: #bd4b00;
  --orange-soft: #fff1e4;
  --ink: #172029;
  --coal: #252d34;
  --muted: #65727c;
  --line: #e9ded3;
  --paper: #fffaf4;
  --white: #ffffff;
  --steel: #53616b;
  --shadow: 0 24px 70px rgba(76, 45, 18, 0.16);
  --font-main: "Poppins", "Montserrat", "Segoe UI", "Helvetica Neue", Arial, sans-serif;
  --font-heading: "Montserrat", "Poppins", "Segoe UI", "Helvetica Neue", Arial, sans-serif;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  color: var(--ink);
  background:
    linear-gradient(90deg, rgba(243, 112, 22, 0.055) 1px, transparent 1px) 0 0 / 42px 42px,
    linear-gradient(#fffaf4, #ffffff 42%, #fff8f0);
  font-family: var(--font-main);
  line-height: 1.58;
}

a {
  color: inherit;
  text-decoration: none;
}

.site-header {
  position: sticky;
  top: 0;
  z-index: 50;
  border-bottom: 1px solid rgba(233, 222, 211, 0.9);
  background: rgba(255, 250, 244, 0.94);
  backdrop-filter: blur(16px);
}

.topbar {
  min-height: 38px;
  padding: 8px max(18px, calc((100vw - 1200px) / 2));
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  color: #fff4eb;
  background: var(--coal);
  font-size: 0.86rem;
  font-weight: 500;
}

.topbar div {
  display: flex;
  align-items: center;
  gap: 18px;
  flex-wrap: wrap;
}

.topbar a:hover,
.topbar a:focus-visible {
  color: #ffb276;
  outline: none;
}

.home-page .site-header {
  position: absolute;
  width: 100%;
  border-bottom: 1px solid rgba(255, 255, 255, 0.22);
  background: linear-gradient(180deg, rgba(10, 18, 24, 0.5), rgba(10, 18, 24, 0));
  backdrop-filter: none;
}

.home-page .topbar {
  display: none;
}

.home-page .nav {
  min-height: 96px;
}

.home-page .brand strong,
.home-page .brand small,
.home-page .nav-links > a,
.home-page .nav-item > a {
  color: #ffffff;
}

.home-page .brand small {
  color: rgba(255, 255, 255, 0.78);
}

.home-page .nav-links a.active,
.home-page .nav-links a:hover,
.home-page .nav-links a:focus-visible {
  color: #ffffff;
  background: rgba(255, 255, 255, 0.13);
}

.home-page .mega-column a,
.home-page .mega-column strong a {
  color: #39454d;
  background: transparent;
}

.home-page .mega-column a:hover,
.home-page .mega-column a:focus-visible {
  color: var(--orange-dark);
  background: transparent;
}

.nav {
  width: min(1200px, calc(100% - 36px));
  min-height: 78px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 26px;
}

.brand {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  min-width: max-content;
}

.brand-logo {
  width: 56px;
  height: 56px;
  display: block;
  flex: 0 0 auto;
  object-fit: contain;
}

.brand strong,
.brand small {
  display: block;
}

.brand strong {
  font-family: var(--font-heading);
  font-size: 1.2rem;
  line-height: 1.05;
  font-weight: 900;
}

.brand small {
  color: var(--muted);
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}

.nav-links {
  display: flex;
  align-items: center;
  gap: 6px;
}

.nav-links a {
  padding: 10px 14px;
  border-radius: 6px;
  color: #313b43;
  font-weight: 700;
  font-size: 0.94rem;
  letter-spacing: 0.01em;
}

.nav-links a:hover,
.nav-links a:focus-visible {
  color: var(--orange-dark);
  background: var(--orange-soft);
  outline: none;
}

.nav-links a.active {
  color: var(--orange-dark);
  background: var(--orange-soft);
}

.nav-links .nav-quote {
  margin-left: 4px;
  color: var(--white);
  background: var(--orange);
}

.nav-links .nav-quote:hover,
.nav-links .nav-quote:focus-visible {
  color: var(--white);
  background: var(--orange-dark);
}

.nav-item {
  position: relative;
}

.nav-item > a {
  display: inline-flex;
  align-items: center;
}

.mega-menu {
  position: absolute;
  top: calc(100% + 14px);
  left: 50%;
  width: min(980px, calc(100vw - 36px));
  padding: 22px;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 14px;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: #ffffff;
  box-shadow: var(--shadow);
  opacity: 0;
  pointer-events: none;
  transform: translate(-50%, 8px);
  transition: opacity 160ms ease, transform 160ms ease;
}

.nav-item:hover .mega-menu,
.nav-item:focus-within .mega-menu {
  opacity: 1;
  pointer-events: auto;
  transform: translate(-50%, 0);
}

.mega-column {
  padding: 14px;
  border-radius: 7px;
  background: #fffaf5;
}

.mega-column strong {
  display: block;
  margin-bottom: 10px;
  color: var(--orange-dark);
  font-size: 0.86rem;
  font-weight: 900;
  text-transform: uppercase;
}

.mega-column a {
  display: block;
  padding: 7px 0;
  color: #39454d;
  font-size: 0.84rem;
  font-weight: 600;
  line-height: 1.28;
}

.mega-column a:hover,
.mega-column a:focus-visible {
  color: var(--orange-dark);
  background: transparent;
}

.nav-toggle {
  display: none;
  width: 44px;
  height: 44px;
  border: 1px solid var(--line);
  border-radius: 6px;
  background: var(--white);
}

.nav-toggle span {
  display: block;
  width: 20px;
  height: 2px;
  margin: 5px auto;
  background: var(--ink);
}

.hero {
  width: min(1200px, calc(100% - 36px));
  min-height: calc(100vh - 150px);
  margin: 0 auto;
  padding: 58px 0 46px;
  display: grid;
  grid-template-columns: 0.92fr 1.08fr;
  align-items: center;
  gap: 42px;
}

.home-hero {
  position: relative;
  min-height: 100vh;
  padding: 140px 18px 104px;
  display: grid;
  place-items: center;
  overflow: hidden;
  color: #ffffff;
  background-image:
    linear-gradient(90deg, rgba(8, 18, 25, 0.76), rgba(8, 18, 25, 0.35)),
    linear-gradient(180deg, rgba(8, 18, 25, 0.42), rgba(8, 18, 25, 0.58)),
    url("assets/factory-home.jpg");
  background-size: cover;
  background-position: center;
}

.home-hero::after {
  content: "";
  position: absolute;
  inset: 0;
  background:
    linear-gradient(90deg, rgba(255, 255, 255, 0.08) 1px, transparent 1px) 0 0 / 64px 64px,
    radial-gradient(circle at 74% 16%, rgba(243, 112, 22, 0.34), transparent 24rem);
  pointer-events: none;
}

.home-hero-content {
  position: relative;
  z-index: 1;
  width: min(980px, 100%);
  display: grid;
  justify-items: center;
  text-align: center;
}

.home-kicker {
  margin: 0 0 26px;
  color: rgba(255, 255, 255, 0.88);
  font-size: clamp(1rem, 2vw, 1.35rem);
  font-weight: 700;
}

.home-kicker::before,
.home-kicker::after {
  content: "";
  display: inline-block;
  width: 42px;
  height: 2px;
  margin: 0 12px 0.35em;
  background: rgba(255, 255, 255, 0.7);
}

.home-hero h1 {
  max-width: 12ch;
  color: #ffffff;
  font-size: clamp(3.9rem, 8.8vw, 8.4rem);
  line-height: 1.04;
  text-transform: uppercase;
  text-shadow: 0 18px 42px rgba(0, 0, 0, 0.36);
}

.home-hero p:not(.home-kicker) {
  max-width: 720px;
  margin: 28px 0 0;
  color: rgba(255, 255, 255, 0.88);
  font-size: 1.08rem;
}

.home-hero .hero-actions {
  justify-content: center;
}

.home-hero .button.primary {
  background: var(--orange);
}

.home-hero .light-button {
  color: #ffffff;
  border-color: rgba(255, 255, 255, 0.72);
  background: rgba(255, 255, 255, 0.08);
}

.cert-strip {
  width: min(1200px, calc(100% - 36px));
  margin: 42px auto 54px;
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: 0.86fr 1.14fr;
  gap: 18px;
  padding: 16px 18px;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: var(--shadow);
}

.cert-intro {
  display: grid;
  align-content: center;
  gap: 4px;
}

.cert-intro .eyebrow {
  margin-bottom: 2px;
}

.cert-intro strong {
  color: var(--ink);
  font-family: var(--font-heading);
  font-size: clamp(1.25rem, 2.45vw, 1.92rem);
  line-height: 1.06;
}

.cert-list {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10px;
}

.cert-list article {
  min-height: 110px;
  padding: 12px 10px;
  display: grid;
  align-content: center;
  justify-items: center;
  gap: 5px;
  border: 1px solid #f1dfcf;
  border-radius: 8px;
  background: #fffaf5;
  text-align: center;
}

.cert-icon {
  width: 42px;
  height: 42px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: var(--orange-soft);
}

.cert-icon svg {
  width: 30px;
  height: 30px;
  fill: none;
  stroke: var(--orange);
  stroke-linecap: round;
  stroke-linejoin: round;
  stroke-width: 3.2;
}

.cert-list strong {
  color: var(--orange-dark);
  font-family: var(--font-heading);
  font-size: 0.94rem;
  font-weight: 900;
}

.cert-list small {
  color: var(--muted);
  font-size: 0.72rem;
  font-weight: 700;
  line-height: 1.28;
}

.page-hero {
  width: min(1200px, calc(100% - 36px));
  margin: 0 auto;
  padding: 86px 0 36px;
}

.page-hero h1 {
  max-width: 13ch;
}

.page-hero p:not(.eyebrow) {
  max-width: 720px;
  margin: 22px 0 0;
  color: #44515a;
  font-size: 1.08rem;
}

.eyebrow {
  margin: 0 0 12px;
  color: var(--orange-dark);
  font-size: 0.78rem;
  font-weight: 800;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

h1,
h2,
h3,
p,
span,
a {
  overflow-wrap: anywhere;
}

h1,
h2,
h3 {
  margin: 0;
  font-family: var(--font-heading);
  letter-spacing: 0;
}

h1 {
  max-width: 12ch;
  font-size: clamp(3.1rem, 6.8vw, 6.2rem);
  line-height: 1.03;
  font-weight: 900;
}

h2 {
  max-width: 16ch;
  font-size: clamp(2.05rem, 4.2vw, 3.65rem);
  line-height: 1.08;
  font-weight: 900;
}

h3 {
  font-size: 1.32rem;
  line-height: 1.18;
  font-weight: 800;
}

.hero-copy p:not(.eyebrow) {
  max-width: 650px;
  margin: 24px 0 0;
  color: #44515a;
  font-size: 1.08rem;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 14px;
  margin-top: 32px;
}

.button {
  min-height: 50px;
  padding: 12px 22px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 6px;
  font-weight: 800;
  letter-spacing: 0.01em;
  transition: transform 180ms ease, box-shadow 180ms ease, background 180ms ease;
}

.button:hover,
.button:focus-visible {
  transform: translateY(-2px);
  outline: none;
}

.button.primary {
  color: var(--white);
  background: var(--orange);
  box-shadow: 0 16px 32px rgba(243, 112, 22, 0.28);
}

.button.secondary {
  color: var(--orange-dark);
  border: 2px solid var(--orange);
  background: var(--white);
}

.hero-badges {
  margin-top: 26px;
  display: flex;
  flex-wrap: wrap;
  gap: 9px;
}

.hero-badges span {
  padding: 9px 12px;
  border: 1px solid #f2caa9;
  border-radius: 999px;
  color: #653615;
  background: #fff7ef;
  font-size: 0.82rem;
  font-weight: 700;
}

.hero-panel {
  min-width: 0;
  position: relative;
}

.hero-panel::before {
  content: "";
  position: absolute;
  inset: 16px -10px -8px 42px;
  z-index: -1;
  border-radius: 20px;
  background: var(--orange);
  opacity: 0.12;
}

.hero-panel svg {
  display: block;
  width: 100%;
  height: auto;
}

.hero-photo-panel {
  overflow: hidden;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: #ffffff;
  box-shadow: var(--shadow);
}

.hero-photo-panel img {
  display: block;
  width: 100%;
  min-height: 440px;
  aspect-ratio: 4 / 3;
  object-fit: cover;
  object-position: center;
}

.hero-photo-caption {
  position: absolute;
  right: 18px;
  bottom: 18px;
  padding: 14px 16px;
  display: grid;
  gap: 2px;
  border-radius: 7px;
  color: #ffffff;
  background: rgba(243, 112, 22, 0.94);
  box-shadow: 0 14px 30px rgba(55, 30, 11, 0.22);
}

.hero-photo-caption strong,
.hero-photo-caption span {
  display: block;
}

.hero-photo-caption strong {
  font-weight: 900;
}

.hero-photo-caption span {
  font-size: 0.86rem;
  font-weight: 600;
}

.hero-bg-card {
  fill: #fff7ed;
  stroke: #ead9c7;
  stroke-width: 3;
}

.hero-sun {
  fill: #ffd4a6;
}

.hero-factory-roof {
  fill: #2b353d;
}

.hero-factory-wall {
  fill: #ffffff;
  stroke: #d9cbbb;
  stroke-width: 3;
}

.hero-factory-door {
  fill: url(#heroOrange);
}

.hero-factory-window {
  fill: #deebef;
  stroke: #52606a;
  stroke-width: 6;
}

.hero-ground {
  fill: #efe0cf;
}

.hero-temp-fence rect:first-child,
.hero-spear-fence rect {
  fill: #ffffff;
  stroke: #53616b;
  stroke-width: 8;
}

.hero-temp-fence path,
.hero-spear-fence path,
.hero-rail path {
  fill: none;
  stroke: url(#heroSteel);
  stroke-linecap: round;
  stroke-linejoin: round;
  stroke-width: 8;
}

.hero-temp-fence rect:nth-last-child(-n + 2) {
  fill: url(#heroOrange);
  stroke: none;
}

.hero-spear-fence .heads {
  fill: var(--orange);
  stroke: var(--orange-dark);
}

.hero-rail path {
  stroke: var(--orange);
  stroke-width: 12;
}

.hero-rail path:nth-child(n + 3) {
  stroke: #53616b;
  stroke-width: 8;
}

.hero-labels rect {
  fill: #ffffff;
  stroke: #f2c9a6;
}

.hero-labels text {
  fill: var(--orange-dark);
  font-family: var(--font-main);
  font-size: 18px;
  font-weight: 900;
}

.proof-bar {
  width: min(1200px, calc(100% - 36px));
  margin: 0 auto 68px;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  border: 1px solid var(--line);
  border-radius: 8px;
  overflow: hidden;
  background: var(--line);
  box-shadow: var(--shadow);
}

.proof-bar article {
  min-height: 132px;
  padding: 24px;
  background: var(--white);
}

.proof-bar strong,
.proof-bar span {
  display: block;
}

.proof-bar strong {
  margin-bottom: 8px;
  color: var(--orange-dark);
  font-family: var(--font-heading);
  font-size: 1.18rem;
  font-weight: 800;
}

.proof-bar span {
  color: var(--muted);
  font-size: 0.95rem;
}

.section {
  width: min(1200px, calc(100% - 36px));
  margin: 0 auto;
  padding: 76px 0;
}

.intro {
  display: grid;
  grid-template-columns: 0.9fr 1fr;
  gap: 42px;
  align-items: end;
}

.intro > p {
  margin: 0;
  color: #45525c;
  font-size: 1.08rem;
}

.section-title-row {
  margin-bottom: 34px;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24px;
}

.text-link {
  flex: 0 0 auto;
  color: var(--orange-dark);
  font-weight: 800;
  border-bottom: 2px solid var(--orange);
}

.category-grid {
  display: grid;
  grid-template-columns: 1.08fr 1fr 1fr;
  gap: 18px;
}

.category-card {
  min-height: 350px;
  padding: 22px;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  gap: 12px;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: var(--white);
  box-shadow: 0 16px 44px rgba(72, 45, 20, 0.08);
}

.category-card.large {
  grid-row: span 2;
  min-height: 718px;
  background: linear-gradient(145deg, #ffffff, #fff0df);
}

.category-card span {
  color: var(--orange-dark);
  font-size: 0.78rem;
  font-weight: 800;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.category-card p {
  margin: 0;
  color: var(--muted);
}

.product-family-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18px;
}

.product-family-card {
  min-height: 560px;
  padding: 24px;
  display: flex;
  flex-direction: column;
  gap: 14px;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: #ffffff;
  box-shadow: 0 16px 44px rgba(72, 45, 20, 0.08);
}

.product-family-card span {
  color: var(--orange-dark);
  font-size: 0.78rem;
  font-weight: 800;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

.product-family-card p {
  margin: 0;
  color: var(--muted);
}

.family-photo-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10px;
  margin-bottom: 4px;
}

.family-photo-grid a {
  display: block;
  overflow: hidden;
  border: 1px solid #f1dfcf;
  border-radius: 7px;
  background: #fff7ef;
}

.family-photo-grid img {
  display: block;
  width: 100%;
  aspect-ratio: 4 / 3;
  object-fit: cover;
  transition: transform 180ms ease;
}

.family-photo-grid a:hover img,
.family-photo-grid a:focus-visible img {
  transform: scale(1.035);
}

.family-photo-grid-five a:first-child {
  grid-row: span 2;
}

.family-photo-grid-many {
  grid-template-columns: repeat(4, minmax(0, 1fr));
}

.family-photo-grid-many img {
  aspect-ratio: 1 / 1;
}

.family-art {
  position: relative;
  min-height: 220px;
  margin-bottom: 4px;
  overflow: hidden;
  border-radius: 6px;
  background:
    linear-gradient(90deg, rgba(243, 112, 22, 0.13) 1px, transparent 1px) 0 0 / 30px 30px,
    linear-gradient(#fff9f1, #f3e3d3);
}

.family-art::before,
.family-art::after {
  content: "";
  position: absolute;
}

.residential-art::before {
  left: 34px;
  right: 34px;
  bottom: 48px;
  height: 116px;
  border: 10px solid #56636c;
  border-radius: 6px;
  background:
    repeating-linear-gradient(90deg, transparent 0 42px, rgba(86, 99, 108, 0.72) 42px 48px),
    linear-gradient(180deg, transparent 0 48px, var(--orange) 48px 58px, transparent 58px);
}

.residential-art::after {
  left: 74px;
  right: 74px;
  top: 44px;
  height: 74px;
  border-radius: 999px 999px 0 0;
  border-top: 12px solid var(--orange);
}

.industry-art::before {
  inset: 50px 30px 50px;
  border: 10px solid #56636c;
  border-radius: 6px;
  clip-path: polygon(0 22%, 8% 22%, 8% 0, 15% 22%, 26% 22%, 26% 0, 33% 22%, 44% 22%, 44% 0, 51% 22%, 62% 22%, 62% 0, 69% 22%, 80% 22%, 80% 0, 87% 22%, 100% 22%, 100% 100%, 0 100%);
}

.industry-art::after {
  left: 32px;
  right: 32px;
  top: 110px;
  height: 10px;
  background: var(--orange);
  box-shadow: 0 44px 0 var(--orange);
}

.construction-art {
  background:
    repeating-linear-gradient(90deg, transparent 0 25px, rgba(77, 88, 96, 0.72) 25px 29px),
    repeating-linear-gradient(0deg, transparent 0 25px, rgba(77, 88, 96, 0.72) 25px 29px),
    linear-gradient(#fffdf9, #fff0df);
}

.construction-art::before {
  inset: 34px 32px 58px;
  border: 10px solid #56636c;
  border-radius: 6px;
}

.construction-art::after {
  left: 44px;
  right: 44px;
  bottom: 34px;
  height: 18px;
  border-radius: 999px;
  background: var(--orange);
  box-shadow: 180px 0 0 var(--orange);
}

.security-art::before {
  left: 32px;
  right: 32px;
  bottom: 46px;
  height: 128px;
  border: 10px solid #56636c;
  background: repeating-linear-gradient(90deg, transparent 0 28px, rgba(86, 99, 108, 0.72) 28px 34px);
  clip-path: polygon(0 22%, 9% 22%, 9% 0, 16% 22%, 27% 22%, 27% 0, 34% 22%, 45% 22%, 45% 0, 52% 22%, 63% 22%, 63% 0, 70% 22%, 81% 22%, 81% 0, 88% 22%, 100% 22%, 100% 100%, 0 100%);
}

.security-art::after {
  left: 36px;
  right: 36px;
  top: 42px;
  height: 34px;
  border-top: 8px dashed var(--orange);
  border-bottom: 8px dashed var(--orange);
}

.product-list {
  margin: 8px 0 0;
  padding: 0;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10px;
  list-style: none;
}

.product-list li {
  min-height: 42px;
  padding: 10px 12px 10px 32px;
  position: relative;
  border: 1px solid #f1dfcf;
  border-radius: 6px;
  color: #39454d;
  background: #fffaf5;
  font-size: 0.94rem;
  font-weight: 600;
}

.product-list li::before {
  content: "";
  position: absolute;
  left: 12px;
  top: 17px;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--orange);
}

.product-list a {
  color: inherit;
}

.product-list a:hover,
.product-list a:focus-visible {
  color: var(--orange-dark);
  outline: none;
}

.product-thumb-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 18px;
}

.product-thumb-card {
  display: grid;
  gap: 12px;
  padding: 14px;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: #ffffff;
  box-shadow: 0 12px 32px rgba(72, 45, 20, 0.08);
}

.product-thumb-card img {
  width: 100%;
  aspect-ratio: 4 / 3;
  object-fit: cover;
  border-radius: 6px;
  background: #fff7ef;
}

.product-thumb-card strong {
  min-height: 42px;
  color: #27323a;
  font-size: 0.96rem;
  line-height: 1.25;
}

.product-thumb-card:hover,
.product-thumb-card:focus-visible {
  border-color: #f0bd92;
  outline: none;
}

.product-detail {
  width: min(1200px, calc(100% - 36px));
  margin: 0 auto;
  padding: 44px 0 76px;
}

.product-detail-grid {
  display: grid;
  grid-template-columns: 0.9fr 1.1fr;
  gap: 28px;
  align-items: start;
}

.product-image-panel {
  position: sticky;
  top: 136px;
  padding: 22px;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: #ffffff;
  box-shadow: 0 16px 44px rgba(72, 45, 20, 0.08);
}

.product-photo {
  min-height: 360px;
  border-radius: 7px;
}

.product-photo-img {
  display: block;
  width: 100%;
  aspect-ratio: 4 / 3;
  object-fit: cover;
  border-radius: 7px;
  background: #fff7ef;
}

.product-content-panel {
  display: grid;
  gap: 18px;
}

.product-info-card {
  padding: 24px;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: #ffffff;
}

.product-info-card h2 {
  max-width: none;
  margin-bottom: 16px;
  font-size: clamp(1.45rem, 3vw, 2.15rem);
}

.spec-table {
  width: 100%;
  border-collapse: collapse;
  overflow: hidden;
  border: 1px solid var(--line);
  border-radius: 8px;
}

.spec-table th,
.spec-table td {
  padding: 13px 14px;
  border-bottom: 1px solid var(--line);
  text-align: left;
  vertical-align: top;
}

.spec-table th {
  width: 34%;
  color: var(--orange-dark);
  background: #fff7ef;
  font-size: 0.86rem;
  text-transform: uppercase;
}

.spec-table tr:last-child th,
.spec-table tr:last-child td {
  border-bottom: 0;
}

.use-list {
  margin: 0;
  padding-left: 20px;
  color: #45525c;
}

.price-box {
  padding: 20px;
  border: 2px solid #f3c49f;
  border-radius: 8px;
  background: #fff7ef;
}

.price-box strong {
  display: block;
  color: var(--orange-dark);
  font-size: 1.16rem;
}

.price-box span {
  display: block;
  margin-top: 6px;
  color: #45525c;
}

.card-art {
  position: relative;
  min-height: 168px;
  margin-bottom: auto;
  overflow: hidden;
  border-radius: 6px;
  background:
    linear-gradient(90deg, rgba(243, 112, 22, 0.13) 1px, transparent 1px) 0 0 / 30px 30px,
    linear-gradient(#fff9f1, #f3e3d3);
}

.large .card-art {
  min-height: 378px;
}

.card-art::before,
.card-art::after {
  content: "";
  position: absolute;
}

.mesh-art {
  background:
    repeating-linear-gradient(90deg, transparent 0 25px, rgba(77, 88, 96, 0.72) 25px 29px),
    repeating-linear-gradient(0deg, transparent 0 25px, rgba(77, 88, 96, 0.72) 25px 29px),
    linear-gradient(#fffdf9, #fff0df);
}

.mesh-art::before {
  inset: 24px 28px 50px;
  border: 10px solid #56636c;
  border-radius: 6px;
}

.mesh-art::after {
  left: 42px;
  right: 42px;
  bottom: 30px;
  height: 18px;
  border-radius: 999px;
  background: var(--orange);
  box-shadow: 170px 0 0 var(--orange);
}

.spear-art::before {
  inset: 44px 18px 44px;
  border: 9px solid #56636c;
  border-radius: 5px;
  clip-path: polygon(0 22%, 8% 22%, 8% 0, 15% 22%, 26% 22%, 26% 0, 33% 22%, 44% 22%, 44% 0, 51% 22%, 62% 22%, 62% 0, 69% 22%, 80% 22%, 80% 0, 87% 22%, 100% 22%, 100% 100%, 0 100%);
}

.spear-art::after {
  left: 24px;
  right: 24px;
  top: 104px;
  height: 10px;
  background: var(--orange);
  box-shadow: 0 42px 0 var(--orange);
}

.rail-art::before {
  left: 18px;
  right: 18px;
  top: 64px;
  height: 70px;
  border-top: 16px solid var(--orange);
  border-bottom: 16px solid var(--orange);
  border-radius: 999px;
}

.rail-art::after {
  left: 48px;
  right: 48px;
  bottom: 30px;
  height: 72px;
  background: repeating-linear-gradient(90deg, #53616b 0 9px, transparent 9px 48px);
}

.accessory-art::before {
  width: 96px;
  height: 96px;
  left: 34px;
  top: 42px;
  border: 12px solid var(--orange);
  border-radius: 50%;
}

.accessory-art::after {
  width: 112px;
  height: 76px;
  right: 34px;
  bottom: 38px;
  border: 12px solid #53616b;
  border-radius: 8px;
  box-shadow: -58px -30px 0 -20px #53616b;
}

.systems-band {
  margin: 42px 0;
  padding: 76px max(18px, calc((100vw - 1200px) / 2));
  color: var(--white);
  background:
    linear-gradient(135deg, rgba(23, 32, 41, 0.97), rgba(23, 32, 41, 0.9)),
    repeating-linear-gradient(90deg, transparent 0 58px, rgba(255, 255, 255, 0.08) 58px 60px);
}

.systems-band .eyebrow {
  color: #ffb276;
}

.systems-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
}

.systems-grid article {
  min-height: 192px;
  padding: 24px;
  border: 1px solid rgba(255, 255, 255, 0.16);
  border-radius: 8px;
  background: rgba(255, 255, 255, 0.08);
}

.systems-grid strong,
.systems-grid span {
  display: block;
}

.systems-grid strong {
  margin-bottom: 12px;
  color: #ffb276;
  font-family: var(--font-heading);
  font-size: 1.32rem;
  font-weight: 800;
}

.systems-grid span {
  color: rgba(255, 255, 255, 0.76);
}

.light-grid article {
  border: 1px solid var(--line);
  background: #ffffff;
}

.light-grid strong {
  color: var(--orange-dark);
}

.light-grid span {
  color: var(--muted);
}

.light-grid a {
  display: inline-block;
  margin-top: 24px;
  color: var(--orange-dark);
  font-weight: 800;
  border-bottom: 2px solid var(--orange);
}

.process-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px;
}

.process-grid article {
  min-height: 305px;
  padding: 24px;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: #ffffff;
}

.process-grid span {
  display: grid;
  place-items: center;
  width: 44px;
  height: 44px;
  margin-bottom: 56px;
  border-radius: 6px;
  color: #ffffff;
  background: var(--orange);
  font-weight: 900;
}

.process-grid p {
  color: var(--muted);
}

.factory-gallery {
  padding-top: 20px;
}

.factory-gallery .section-title-row > p {
  max-width: 520px;
  color: var(--muted);
}

.factory-photo-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 16px;
}

.factory-photo-card {
  margin: 0;
  overflow: hidden;
  display: flex;
  min-height: 100%;
  flex-direction: column;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: #ffffff;
  box-shadow: 0 18px 42px rgba(42, 32, 21, 0.08);
}

.factory-photo-card.featured {
  grid-column: span 2;
  grid-row: span 2;
}

.factory-photo-card.tall {
  grid-row: span 2;
}

.factory-photo-card img {
  display: block;
  width: 100%;
  aspect-ratio: 4 / 3;
  object-fit: cover;
  background: #f4eee7;
}

.factory-photo-card.featured img,
.factory-photo-card.tall img {
  flex: 1;
  min-height: 360px;
}

.factory-photo-card figcaption {
  display: grid;
  gap: 6px;
  padding: 14px;
}

.factory-photo-card strong {
  color: var(--orange-dark);
  font-family: var(--font-heading);
  font-size: 1.08rem;
  line-height: 1.05;
}

.factory-photo-card span {
  color: var(--muted);
  font-size: 0.9rem;
  line-height: 1.5;
}

.buyer-section {
  width: min(1200px, calc(100% - 36px));
  margin: 20px auto;
  padding: 44px;
  display: grid;
  grid-template-columns: 0.8fr 1.2fr;
  gap: 30px;
  border-radius: 8px;
  background: var(--orange);
  color: #ffffff;
  box-shadow: var(--shadow);
}

.factory-proof {
  margin-top: 64px;
  margin-bottom: 76px;
}

.buyer-section .eyebrow {
  color: #fff1e4;
}

.buyer-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14px;
}

.buyer-grid article {
  padding: 24px;
  border: 1px solid rgba(255, 255, 255, 0.34);
  border-radius: 8px;
  background: rgba(255, 255, 255, 0.14);
}

.buyer-grid p {
  color: rgba(255, 255, 255, 0.82);
}

.buyer-grid a {
  color: #ffffff;
  font-weight: 900;
  border-bottom: 2px solid #ffffff;
}

.blog-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18px;
}

.blog-grid article {
  min-height: 260px;
  padding: 24px;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: #ffffff;
}

.blog-grid span {
  display: inline-block;
  margin-bottom: 30px;
  color: var(--orange-dark);
  font-size: 0.78rem;
  font-weight: 900;
  text-transform: uppercase;
}

.blog-grid p {
  color: var(--muted);
}

.contact {
  width: min(1200px, calc(100% - 36px));
  margin: 0 auto 72px;
  padding: 44px;
  display: grid;
  grid-template-columns: 0.9fr 1.1fr;
  gap: 34px;
  border-radius: 8px;
  color: #ffffff;
  background:
    linear-gradient(135deg, rgba(243, 112, 22, 0.98), rgba(196, 78, 0, 0.98)),
    repeating-linear-gradient(90deg, transparent 0 46px, rgba(255, 255, 255, 0.14) 46px 48px);
  box-shadow: var(--shadow);
}

.mini-contact,
.contact-page-panel {
  margin-top: 18px;
}

.contact .eyebrow {
  color: #fff1e4;
}

.contact p {
  max-width: 520px;
  color: rgba(255, 255, 255, 0.82);
}

.contact-panel {
  display: grid;
  gap: 12px;
}

.contact-panel a,
.contact-panel address {
  min-height: 78px;
  margin: 0;
  padding: 18px 20px;
  display: grid;
  gap: 4px;
  border: 1px solid rgba(255, 255, 255, 0.34);
  border-radius: 8px;
  background: rgba(255, 255, 255, 0.15);
  font-style: normal;
}

.contact-panel strong {
  font-size: 0.78rem;
  text-transform: uppercase;
}

.contact-panel span {
  font-size: 1.04rem;
}

.footer {
  padding: 46px max(18px, calc((100vw - 1200px) / 2));
  display: grid;
  grid-template-columns: 1.4fr repeat(3, 1fr);
  gap: 28px;
  color: rgba(255, 255, 255, 0.74);
  background: #172029;
}

.footer .brand-logo {
  filter: drop-shadow(0 8px 16px rgba(0, 0, 0, 0.26));
}

.footer strong {
  display: block;
  margin-bottom: 12px;
  color: #ffffff;
}

.footer a,
.footer span {
  display: block;
  margin: 8px 0;
}

.footer a:hover,
.footer a:focus-visible {
  color: #ffb276;
  outline: none;
}

.footer-brand {
  margin-bottom: 18px;
  color: #ffffff;
}

.footer-brand small {
  color: rgba(255, 255, 255, 0.64);
}

.footer p {
  max-width: 360px;
}

.footer-social {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-top: 20px;
}

.footer .footer-social a {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 42px;
  height: 42px;
  margin: 0;
  border-radius: 50%;
  color: #ffffff;
  background: #1877f2;
  box-shadow: 0 12px 24px rgba(0, 0, 0, 0.22);
  transition: transform 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
}

.footer .footer-social a:nth-child(2) {
  background: #0a66c2;
}

.footer .footer-social a:nth-child(3) {
  background: #16a862;
}

.footer .footer-social a:hover,
.footer .footer-social a:focus-visible {
  color: #ffffff;
  transform: translateY(-2px);
  box-shadow: 0 16px 30px rgba(0, 0, 0, 0.28);
}

.footer-social svg {
  width: 22px;
  height: 22px;
  fill: currentColor;
}

.footer-contact .footer-contact-item {
  position: relative;
  display: flex;
  align-items: flex-start;
  gap: 10px;
  margin: 10px 0;
  line-height: 1.45;
}

.footer-contact .footer-contact-item::before {
  content: "";
  flex: 0 0 auto;
  width: 22px;
  height: 22px;
  margin-top: 3px;
  background-color: #ff9a3c;
  mask-repeat: no-repeat;
  mask-position: center;
  mask-size: contain;
  -webkit-mask-repeat: no-repeat;
  -webkit-mask-position: center;
  -webkit-mask-size: contain;
}

.footer-contact-phone::before {
  mask-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M6.6 3.6c.4-.4 1-.5 1.5-.3l2.6 1.1c.5.2.8.7.8 1.2v2.5c0 .5-.3 1-.7 1.2l-1.3.7c.9 1.8 2.3 3.2 4.1 4.1l.7-1.3c.2-.5.7-.7 1.2-.7H18c.5 0 1 .3 1.2.8l1.1 2.6c.2.5.1 1.1-.3 1.5l-1.2 1.2c-.9.9-2.2 1.3-3.5 1C9.9 17.8 6.2 14.1 4.8 8.7c-.3-1.3.1-2.6 1-3.5l.8-1.6zM7.3 5.4l-.5.8c-.5.5-.7 1.3-.5 2 1.2 4.7 4.8 8.3 9.5 9.5.7.2 1.5 0 2-.5l.7-.7-.8-1.9h-1.8l-1 1.8c-.3.5-.9.7-1.4.5-2.8-1.1-5-3.3-6.1-6.1-.2-.6 0-1.2.5-1.4l1.8-1V6.6l-2.4-1.2z'/%3E%3C/svg%3E");
  -webkit-mask-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M6.6 3.6c.4-.4 1-.5 1.5-.3l2.6 1.1c.5.2.8.7.8 1.2v2.5c0 .5-.3 1-.7 1.2l-1.3.7c.9 1.8 2.3 3.2 4.1 4.1l.7-1.3c.2-.5.7-.7 1.2-.7H18c.5 0 1 .3 1.2.8l1.1 2.6c.2.5.1 1.1-.3 1.5l-1.2 1.2c-.9.9-2.2 1.3-3.5 1C9.9 17.8 6.2 14.1 4.8 8.7c-.3-1.3.1-2.6 1-3.5l.8-1.6zM7.3 5.4l-.5.8c-.5.5-.7 1.3-.5 2 1.2 4.7 4.8 8.3 9.5 9.5.7.2 1.5 0 2-.5l.7-.7-.8-1.9h-1.8l-1 1.8c-.3.5-.9.7-1.4.5-2.8-1.1-5-3.3-6.1-6.1-.2-.6 0-1.2.5-1.4l1.8-1V6.6l-2.4-1.2z'/%3E%3C/svg%3E");
}

.footer-contact-mail::before {
  mask-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M4.5 5h15c1 0 1.8.8 1.8 1.8v10.4c0 1-.8 1.8-1.8 1.8h-15c-1 0-1.8-.8-1.8-1.8V6.8c0-1 .8-1.8 1.8-1.8zm.2 2.1v.5l7.3 4.8 7.3-4.8v-.5H4.7zm14.6 2.9-6.7 4.4c-.4.3-.8.3-1.2 0L4.7 10v6.9h14.6V10z'/%3E%3C/svg%3E");
  -webkit-mask-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M4.5 5h15c1 0 1.8.8 1.8 1.8v10.4c0 1-.8 1.8-1.8 1.8h-15c-1 0-1.8-.8-1.8-1.8V6.8c0-1 .8-1.8 1.8-1.8zm.2 2.1v.5l7.3 4.8 7.3-4.8v-.5H4.7zm14.6 2.9-6.7 4.4c-.4.3-.8.3-1.2 0L4.7 10v6.9h14.6V10z'/%3E%3C/svg%3E");
}

.footer-contact-location::before {
  mask-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M12 2.8a7.1 7.1 0 0 0-7.1 7.1c0 4.9 5.9 10.9 6.2 11.1.5.5 1.3.5 1.8 0 .3-.2 6.2-6.2 6.2-11.1A7.1 7.1 0 0 0 12 2.8zm0 15.9c-1.8-2-5-6-5-8.8a5 5 0 0 1 10 0c0 2.8-3.2 6.8-5 8.8zm0-11.5a2.8 2.8 0 1 0 0 5.6 2.8 2.8 0 0 0 0-5.6zm0 3.6a.8.8 0 1 1 0-1.6.8.8 0 0 1 0 1.6z'/%3E%3C/svg%3E");
  -webkit-mask-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 24 24' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M12 2.8a7.1 7.1 0 0 0-7.1 7.1c0 4.9 5.9 10.9 6.2 11.1.5.5 1.3.5 1.8 0 .3-.2 6.2-6.2 6.2-11.1A7.1 7.1 0 0 0 12 2.8zm0 15.9c-1.8-2-5-6-5-8.8a5 5 0 0 1 10 0c0 2.8-3.2 6.8-5 8.8zm0-11.5a2.8 2.8 0 1 0 0 5.6 2.8 2.8 0 0 0 0-5.6zm0 3.6a.8.8 0 1 1 0-1.6.8.8 0 0 1 0 1.6z'/%3E%3C/svg%3E");
}

@media (max-width: 980px) {
  .topbar,
  .hero,
  .page-hero,
  .intro,
  .cert-strip,
  .buyer-section,
  .contact {
    grid-template-columns: 1fr;
  }

  .topbar {
    display: grid;
    justify-items: center;
    text-align: center;
  }

  .nav-toggle {
    display: inline-block;
  }

  .nav-links {
    position: absolute;
    top: 100%;
    right: 18px;
    left: 18px;
    display: none;
    padding: 12px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: #ffffff;
    box-shadow: var(--shadow);
  }

  .nav-links.is-open {
    display: grid;
  }

  .home-page .nav-links.is-open > a,
  .home-page .nav-links.is-open .nav-item > a {
    color: #313b43;
  }

  .home-page .nav-links.is-open a.active,
  .home-page .nav-links.is-open > a:hover,
  .home-page .nav-links.is-open .nav-item > a:hover {
    color: var(--orange-dark);
    background: var(--orange-soft);
  }

  .nav-item {
    display: grid;
  }

  .nav-item > a {
    width: 100%;
  }

  .mega-menu {
    position: static;
    width: 100%;
    margin-top: 8px;
    padding: 12px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    opacity: 1;
    pointer-events: auto;
    transform: none;
    box-shadow: none;
  }

  .nav-links .nav-quote {
    margin-left: 0;
    text-align: center;
  }

  .hero {
    min-height: auto;
    padding-top: 44px;
  }

  h1 {
    max-width: 12ch;
  }

  .proof-bar,
  .cert-list,
  .product-family-grid,
  .product-thumb-grid,
  .factory-photo-grid,
  .category-grid,
  .systems-grid,
  .process-grid,
  .blog-grid,
  .product-detail-grid,
  .footer {
    grid-template-columns: repeat(2, 1fr);
  }

  .product-image-panel {
    position: static;
  }

  .category-card.large {
    grid-row: auto;
    min-height: 350px;
  }

  .large .card-art {
    min-height: 168px;
  }
}

@media (max-width: 640px) {
  .nav,
  .hero,
  .page-hero,
  .proof-bar,
  .cert-strip,
  .section,
  .buyer-section,
  .contact {
    width: min(100% - 24px, 1200px);
  }

  .brand small {
    display: none;
  }

  .topbar div {
    justify-content: center;
    gap: 8px;
  }

  h1 {
    font-size: clamp(2.75rem, 15vw, 4rem);
  }

  .home-hero {
    min-height: 92vh;
    padding-top: 120px;
    padding-bottom: 72px;
    background-position: center;
  }

  .cert-strip {
    margin-top: 18px;
  }

  .home-hero h1 {
    max-width: 10ch;
    font-size: clamp(3rem, 16vw, 4.6rem);
  }

  .home-kicker::before,
  .home-kicker::after {
    width: 24px;
    margin-inline: 8px;
  }

  h2 {
    font-size: clamp(2rem, 11vw, 3rem);
  }

  .hero-copy p:not(.eyebrow) {
    font-size: 1rem;
  }

  .button {
    width: 100%;
  }

  .proof-bar,
  .cert-list,
  .product-family-grid,
  .product-thumb-grid,
  .factory-photo-grid,
  .category-grid,
  .systems-grid,
  .process-grid,
  .buyer-grid,
  .blog-grid,
  .footer {
    grid-template-columns: 1fr;
  }

  .mega-menu,
  .product-detail-grid {
    grid-template-columns: 1fr;
  }

  .product-detail {
    width: min(100% - 24px, 1200px);
  }

  .product-photo {
    min-height: 260px;
  }

  .factory-photo-card.featured,
  .factory-photo-card.tall {
    grid-column: auto;
    grid-row: auto;
  }

  .factory-photo-card.featured img,
  .factory-photo-card.tall img {
    min-height: auto;
  }

  .section-title-row {
    align-items: flex-start;
    flex-direction: column;
  }

  .buyer-section,
  .contact {
    padding: 24px;
  }

  .process-grid span {
    margin-bottom: 28px;
  }

  .product-list {
    grid-template-columns: 1fr;
  }

  .family-photo-grid-many {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .product-family-card {
    min-height: auto;
  }
}

